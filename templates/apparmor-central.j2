{{ ansible_managed | comment(prefix_count=0, postfix_count=0) }}
# file: {{ template_destpath }}

@{run}/log/journal/** r,
/var/log/ r,
{% if rsyslog_transport == 'tls' %}
include <abstractions/ssl_certs>
"{{ rsyslog_ca_file | default(__rsyslog_ca_bundle, true) }}" r,
{% if rsyslog_client_cert_file %}
"{{ rsyslog_client_cert_file }}" r,
"{{ rsyslog_client_key_file }}" r,
{% endif %}
{% endif %}
{% for path in __rsyslog_file_inputs | map(attribute='path') | unique(case_sensitive=true) %}
{# imfile globs match within a component. AppArmor's double star would also match subdirectories. #}
{% set parts = path.split('/') | map('regex_replace', '[*]+', '*') | map('regex_replace', '\\[[!^](-?)', '[^\\1/') | list %}
{% for part in parts[1:] %}
{% set directory = parts[:loop.index] | join('/') %}
{% if loop.last or (directory ~ '/' ~ part) is search('[*?\\[]') %}
"{{ directory }}/" r,
{% endif %}
{% endfor %}
"{{ parts | join('/') }}" r,
{% endfor %}
