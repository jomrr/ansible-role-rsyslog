{{ ansible_managed | comment(prefix_count=0, postfix_count=0) }}
# file: {{ template_destpath }}

{% if ansible_facts.os_family != 'RedHat' %}
module(load="imjournal" StateFile="{{ __rsyslog_state_directory }}/imjournal.state"
{% if __rsyslog_custom_interval %}
       Ratelimit.Interval="{{ rsyslog_imjournal_ratelimit_interval | int }}"
{% endif %}
{% if __rsyslog_custom_burst %}
       Ratelimit.Burst="{{ rsyslog_imjournal_ratelimit_burst | int }}"
{% endif %}
       PersistStateInterval="100")
{% endif %}
{% if __rsyslog_file_inputs %}
module(load="imfile" statefile.directory="{{ __rsyslog_state_directory }}")
{% endif %}

ruleset(name="central_forward") {
    if prifilt("*.{{ rsyslog_min_severity }}")
{% if rsyslog_excluded_programs %}
       and not ($programname == {{ rsyslog_excluded_programs | to_json(ensure_ascii=false) | replace('$', '\\$') }})
{% endif %}
    then
        action(type="omfwd" target="{{ rsyslog_server }}" port="{{ rsyslog_port }}" protocol="tcp"
               template="RSYSLOG_SyslogProtocol23Format" TCP_Framing="octet-counted"
{% if rsyslog_keepalive | bool %}
               KeepAlive="on" KeepAlive.Time="{{ rsyslog_keepalive_time | int }}"
               KeepAlive.Interval="{{ rsyslog_keepalive_interval | int }}" KeepAlive.Probes="{{ rsyslog_keepalive_probes | int }}"
{% endif %}
{% if rsyslog_transport == 'tls' %}
               StreamDriver="gtls" StreamDriverMode="1" StreamDriverAuthMode="x509/name"
               StreamDriverPermittedPeers="{{ rsyslog_permitted_peers | join(',') }}"
               StreamDriver.CAFile="{{ rsyslog_ca_file | default(__rsyslog_ca_bundle, true) }}"
{% if rsyslog_client_cert_file %}
               StreamDriver.CertFile="{{ rsyslog_client_cert_file }}"
               StreamDriver.KeyFile="{{ rsyslog_client_key_file }}"
{% endif %}
{% endif %}
               action.resumeRetryCount="-1" queue.type="LinkedList" queue.filename="forward"
               queue.spoolDirectory="{{ __rsyslog_state_directory }}"
               queue.maxDiskSpace="{{ rsyslog_queue_max_disk_space }}" queue.saveOnShutdown="on")
}

if $inputname == "imjournal" then {
    call central_forward
{% if ansible_facts.os_family != 'RedHat' and not (rsyslog_forward_only | bool) %}
    # The distribution processes its local socket and kernel inputs separately.
    stop
{% endif %}
}
{% if rsyslog_forward_only | bool %}
# Journal messages have already gone through the forwarding ruleset.
*.* stop
{% endif %}

{% for input in __rsyslog_file_inputs | unique(attribute='path', case_sensitive=true) %}
input(type="imfile" File="{{ input.path }}" Tag="{{ (input.tag | default(input.path | basename)).rstrip(':') }}:"
      Facility="{{ input.facility | default('local0') }}" Severity="info" PersistStateInterval="100" Ruleset="central_forward")
{% endfor %}
